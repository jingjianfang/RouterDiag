require_contains("${CPP}" "QStringLiteral(\"AT+CGMM\")" "module probe must query model")
require_contains("${CPP}" "QStringLiteral(\"AT+CGMR\")" "module probe must query firmware")
require_contains("${MAIN}" "QStringLiteral(\"模组\")" "module card must use the concise name")
